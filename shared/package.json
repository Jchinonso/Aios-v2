{
  "name": "@aios/shared",
  "version": "0.1.0",
  "description": "AIOS Shared - Common modules for AI and Cloud operations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./intelligence": {
      "import": "./dist/intelligence/index.js",
      "types": "./dist/intelligence/index.d.ts"
    },
    "./cloud": {
      "import": "./dist/cloud/index.js",
      "types": "./dist/cloud/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants/index.js",
      "types": "./dist/constants/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "ai",
    "cloud",
    "devops",
    "shared",
    "intelligence",
    "providers"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@aws-sdk/client-amplify": "^3.899.0",
    "@aws-sdk/client-cloudformation": "^3.901.0",
    "@aws-sdk/client-cloudfront": "^3.901.0",
    "@aws-sdk/client-ec2": "^3.616.0",
    "@aws-sdk/client-lambda": "^3.901.0",
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/client-sts": "^3.901.0",
    "@aws-sdk/lib-storage": "^3.901.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@netlify/api": "^14.0.5",
    "@vercel/sdk": "^1.11.4",
    "axios": "^1.7.2",
    "cohere-ai": "^7.19.0",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "openai": "^4.52.7",
    "replicate": "^1.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
